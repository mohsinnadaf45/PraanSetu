# ============================================================
# PraanSetu � Environment Variables Example
# Copy to .env (never commit .env to git)
# ============================================================

# -- Application ----------------------------------------------
APP_ENV=local                          # local | staging | pilot | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://app.praansetu.in

# -- Security -------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# -- Main Database (PostgreSQL) --------------------------------
DATABASE_URL=postgresql+asyncpg://praansetu:praansetu_pass@localhost:5432/praansetu_main
DATABASE_URL_SYNC=postgresql://praansetu:praansetu_pass@localhost:5432/praansetu_main

# -- Identity Vault Database (PostgreSQL) ---------------------
VAULT_DATABASE_URL=postgresql+asyncpg://vault_user:vault_pass@localhost:5433/praansetu_vault
VAULT_DATABASE_URL_SYNC=postgresql://vault_user:vault_pass@localhost:5433/praansetu_vault

# -- Redis / Celery -------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -- Encryption (AES-256 field-level for vault) ----------------
VAULT_ENCRYPTION_KEY=changeme_fernet_key_base64_urlsafe_32_bytes

# AWS KMS (optional; if blank, falls back to local VAULT_ENCRYPTION_KEY)
AWS_KMS_KEY_ARN=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- Email / Notifications ------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@praansetu.in
SMTP_PASSWORD=changeme
SMTP_FROM_ADDRESS=noreply@praansetu.in
SMTP_USE_TLS=true

# SMS gateway
SMS_GATEWAY_PROVIDER=sns
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_API_SECRET=
SMS_FROM_NUMBER=+91XXXXXXXXXX

# -- Audit Checkpoint -----------------------------------------
CHECKPOINT_STORE_URL=
CHECKPOINT_STORE_TOKEN=

# -- Matching Engine ------------------------------------------
RULES_DIR=packages/matching-engine/rules

# -- Sentry ---------------------------------------------------
SENTRY_DSN=

# -- Rate Limiting --------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# -- Admin Bootstrap ------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@praansetu.in
BOOTSTRAP_ADMIN_PASSWORD=changeme_strong_password
